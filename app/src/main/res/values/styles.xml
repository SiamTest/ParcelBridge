<resources>
    <style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item>
        <item name="colorPrimary">@color/brand_primary</item><item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item><item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item><item name="colorSecondaryContainer">@color/brand_secondary_container</item><item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="colorTertiary">@color/brand_tertiary</item><item name="colorTertiaryContainer">@color/brand_tertiary_container</item><item name="colorOnTertiaryContainer">@color/brand_on_tertiary_container</item>
        <item name="colorSurface">@color/brand_surface</item><item name="colorOnSurface">@color/brand_on_surface</item><item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/brand_surface_low</item><item name="colorSurfaceContainerLow">@color/brand_surface_low</item><item name="colorSurfaceContainerHigh">@color/brand_surface_high</item><item name="colorSurfaceContainerHighest">@color/brand_surface_highest</item><item name="colorSurfaceContainerLowest">@color/brand_surface_lowest</item>
        <item name="colorOutline">@color/brand_outline</item><item name="colorOutlineVariant">@color/brand_outline_variant</item>
        <item name="android:windowBackground">@color/brand_surface</item><item name="android:statusBarColor">@android:color/transparent</item><item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="textInputStyle">@style/AppInput</item>
        <item name="materialAlertDialogTheme">@style/AppDialog</item>
        <item name="shapeAppearanceMediumComponent">@style/AppShape.Card</item>
        <item name="shapeAppearanceLargeComponent">@style/AppShape.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="TypeBody" parent="TextAppearance.Material3.BodyLarge"><item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item></style>
    <style name="TypeTitle" parent="TextAppearance.Material3.TitleLarge.Emphasized"><item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item></style>
    <style name="TypeHeadline" parent="TextAppearance.Material3.HeadlineMedium.Emphasized"><item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item></style>
    <style name="TypeLabel" parent="TextAppearance.Material3.LabelLarge.Emphasized"><item name="fontFamily">@font/inter</item><item name="android:fontFamily">@font/inter</item></style>
    <style name="AppButton" parent="Widget.Material3Expressive.Button"><item name="android:textAppearance">@style/TypeLabel</item><item name="android:textAllCaps">false</item></style>
    <style name="AppInput" parent="Widget.Material3.TextInputLayout.OutlinedBox"><item name="shapeAppearance">@style/AppShape.Input</item><item name="hintTextAppearance">@style/TypeLabel</item></style>
    <style name="AppDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog"><item name="shapeAppearance">@style/AppShape.Dialog</item></style>
    <style name="AppShape.Card" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSizeTopLeft">24dp</item><item name="cornerSizeTopRight">12dp</item><item name="cornerSizeBottomLeft">12dp</item><item name="cornerSizeBottomRight">24dp</item></style>
    <style name="AppShape.Input" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSize">16dp</item></style>
    <style name="AppShape.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge"><item name="cornerSize">28dp</item></style>
</resources>
